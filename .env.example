# =============================================================================
# AgentShield AI — Environment Configuration Example
# =============================================================================
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Deployment mode
# ---------------------------------------------------------------------------
# "local"  — backend and desktop run on the same machine or local network.
# "remote" — desktop connects to a remote backend over HTTPS.
AGENTSHIELD_ENV=local

# ---------------------------------------------------------------------------
# Backend API
# ---------------------------------------------------------------------------
# The URL the desktop application and integrations use to reach the backend.
# In local mode this is typically http://localhost:8000.
# In remote mode this must be an HTTPS URL.
AGENTSHIELD_BACKEND_URL=http://localhost:8000

# API version prefix (default: /api/v1)
AGENTSHIELD_API_PREFIX=/api/v1

# ---------------------------------------------------------------------------
# Security / Authentication
# ---------------------------------------------------------------------------
# Secret key used to sign JWT tokens. Use a long random string in production.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
AGENTSHIELD_SECRET_KEY=CHANGE_ME_generate_a_secure_random_key

# Token expiry in minutes (default: 60)
AGENTSHIELD_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL DSN (used in production / remote mode)
# Format: postgresql+asyncpg://user:password@host:port/dbname
AGENTSHIELD_DATABASE_URL=postgresql+asyncpg://agentshield:CHANGE_ME@localhost:5432/agentshield

# SQLite DSN (used for local development when DATABASE_URL is not set)
# Format: sqlite+aiosqlite:///./agentshield.db
AGENTSHIELD_SQLITE_URL=sqlite+aiosqlite:///./agentshield_dev.db

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
AGENTSHIELD_LOG_LEVEL=INFO

# Log format: "json" (structured, for production) | "console" (human-readable)
AGENTSHIELD_LOG_FORMAT=console

# ---------------------------------------------------------------------------
# Backend server (uvicorn)
# ---------------------------------------------------------------------------
AGENTSHIELD_HOST=0.0.0.0
AGENTSHIELD_PORT=8000
AGENTSHIELD_RELOAD=false

# ---------------------------------------------------------------------------
# CORS (comma-separated origins allowed to call the backend)
# ---------------------------------------------------------------------------
AGENTSHIELD_CORS_ORIGINS=http://localhost:3000,http://localhost:8080
