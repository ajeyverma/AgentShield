# ==============================================================================
# AgentShield AI — Local Development Environment Example
# Copy to .env for local development
# ==============================================================================

# Deployment Mode: LOCAL (single machine / LAN) or REMOTE (hosted backend)
AGENTSHIELD_ENV=LOCAL

# Application Info
AGENTSHIELD_APP_NAME="AgentShield AI"
AGENTSHIELD_APP_VERSION="0.1.0"

# Backend Binding
AGENTSHIELD_HOST=127.0.0.1
AGENTSHIELD_PORT=8000
AGENTSHIELD_BACKEND_URL=http://localhost:8000
AGENTSHIELD_API_PREFIX=/api/v1
AGENTSHIELD_RELOAD=false

# Authentication / Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
AGENTSHIELD_SECRET_KEY=dev_secret_key_change_me_to_a_secure_random_string_in_production_32chars!
AGENTSHIELD_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
# Leave DATABASE_URL blank to automatically use local SQLite dev database
# AGENTSHIELD_DATABASE_URL=
AGENTSHIELD_SQLITE_URL=sqlite+aiosqlite:///./agentshield_dev.db

# Logging
AGENTSHIELD_LOG_LEVEL=INFO
AGENTSHIELD_LOG_FORMAT=console

# Allowed CORS Origins
AGENTSHIELD_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# Twilio WhatsApp Notifications (Human Approval Alerts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+916393121212
