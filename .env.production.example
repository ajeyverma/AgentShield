# ==============================================================================
# AgentShield AI — Production Environment Template
# Copy to .env on production hosts / containers
# ==============================================================================

# Deployment Mode (MANDATORY: remote)
AGENTSHIELD_ENV=REMOTE

# Backend Connection (Must use HTTPS and WSS in production)
AGENTSHIELD_HOST=0.0.0.0
AGENTSHIELD_PORT=8000
AGENTSHIELD_BACKEND_URL=https://agentshield.yourdomain.com
AGENTSHIELD_API_PREFIX=/api/v1
AGENTSHIELD_RELOAD=false

# Authentication & JWT Signing (MANDATORY: Minimum 64 high-entropy random characters)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
AGENTSHIELD_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_MINIMUM_64_CHARACTERS

# Token Expiration (in minutes)
AGENTSHIELD_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Production PostgreSQL Connection DSN (MANDATORY)
# Format: postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
AGENTSHIELD_DATABASE_URL=postgresql+asyncpg://agentshield:YOUR_STRONG_DB_PASSWORD@localhost:5432/agentshield

# Logging (JSON format for log aggregators / SIEM)
AGENTSHIELD_LOG_LEVEL=INFO
AGENTSHIELD_LOG_FORMAT=json

# Strict CORS configuration (NEVER use wildcards in production)
AGENTSHIELD_CORS_ORIGINS=["https://agentshield.yourdomain.com"]
