# =============================================================================
# AgentShield AI — Backend API Dockerfile
# =============================================================================
# Build:  docker build -f Dockerfile.api -t agentshield-api .
# Run:    docker run -p 8000:8000 --env-file .env agentshield-api
# =============================================================================

FROM python:3.12-slim AS base

LABEL maintainer="AgentShield AI Team"
LABEL description="AgentShield AI — Security Backend API"

# Security: run as non-root
RUN groupadd --gid 1001 agentshield \
    && useradd --uid 1001 --gid agentshield --shell /bin/bash --create-home agentshield

WORKDIR /app

# Install system dependencies
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        gcc \
        libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY pyproject.toml ./
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir ".[api]"

# Copy application source
COPY agentshield/ ./agentshield/
COPY apps/api/ ./apps/api/
COPY apps/__init__.py ./apps/__init__.py

# Ensure non-root ownership
RUN chown -R agentshield:agentshield /app

USER agentshield

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/api/v1/health || exit 1

CMD ["uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
