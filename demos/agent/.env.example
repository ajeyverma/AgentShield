# Subway Coders AI Agent — Environment Configuration
# Copy this file to .env in this directory to configure your environment

AGENT_NAME="Subway Coders"

# AgentShield Gateway Configuration
AGENTSHIELD_BACKEND_URL=http://localhost:8000
AGENTSHIELD_AGENT_ID=subway-coders-001
AGENTSHIELD_TENANT_ID=demo-tenant-001
AGENTSHIELD_AGENT_CREDENTIAL=agsh_demo_secret_credential_token

# Google Gemini API Key (for Gemini Flash model)
GEMINI_API_KEY=

# OpenRouter API Key (for Llama 3.3 70B Instruct)
OPENROUTER_API_KEY=
